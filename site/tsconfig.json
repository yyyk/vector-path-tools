{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "vector-path-tools/internal/flatten": ["../src/flatten.ts"],
      "vector-path-tools": ["../src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
